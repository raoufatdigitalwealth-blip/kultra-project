<main id="main" class="pg"><section class="pg-h"><svg class="lat" aria-hidden="true"><defs><pattern id="sr" width="90" height="78" patternUnits="userSpaceOnUse"><path d="M45 6l30 17v32L45 72 15 55V23z"/></pattern></defs><rect width="100%" height="100%" fill="url(#sr)"/></svg><div class="in"><div class="pg-eb">Search</div><h1>Search <em>results.</em></h1></div></section><div class="pg-w"><div class="pg-in"><form action="/search" method="get" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" style="width:100%;padding:14px 18px;border-radius:999px;border:1px solid #d9cfb7;font:400 17px sans-serif"></form>{% if search.performed %}<h2>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</h2><ul>{% for item in search.results %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}</ul>{% endif %}</div></div></main><script src="{{ 'kultra-nav.js' | asset_url }}" defer></script>