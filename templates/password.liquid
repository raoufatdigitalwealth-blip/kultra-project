{% layout none %}<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name }}</title>{{ content_for_header }}</head><body style="font-family:sans-serif;text-align:center;padding:12vh 24px"><h1>{{ shop.name }}</h1><p>This store is password protected.</p>{% form 'storefront_password' %}<input type="password" name="password" aria-label="Password"><button type="submit">Enter</button>{{ form.errors | default_errors }}{% endform %}</body></html>