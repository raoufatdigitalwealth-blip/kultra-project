<main id="main" class="pg"><div class="pg-w"><div class="ar-hd"><a class="ar-bk" href="{{ blog.url }}">Back to the Journal</a>{% if article.tags.first %}<div class="jn-tg">{{ article.tags.first }}</div>{% endif %}<h1>{{ article.title }}</h1><div class="ar-mt">{{ article.published_at | date: '%-d %B %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</div></div>{% if article.image %}<div class="ar-im"><img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | escape }}"></div>{% endif %}<div class="pg-in">{{ article.content }}<p><a class="pg-btn" href="/products/goat-whey-protein" style="color:#fff">Shop Goat Whey Protein</a></p></div></div></main><script src="{{ 'kultra-nav.js' | asset_url }}" defer></script>