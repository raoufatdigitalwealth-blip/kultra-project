<main id="main" class="pg"><section class="pg-h"><svg class="lat" aria-hidden="true"><defs><pattern id="co" width="90" height="78" patternUnits="userSpaceOnUse"><path d="M45 6l30 17v32L45 72 15 55V23z"/></pattern></defs><rect width="100%" height="100%" fill="url(#co)"/></svg><div class="in"><div class="pg-eb">Shop</div><h1>{{ collection.title }}</h1></div></section><div class="pg-w"><div class="jn-g">{% for product in collection.products %}<a class="jn-c" href="{{ product.url }}"><div class="im">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">{% endif %}</div><div class="tx"><h3>{{ product.title }}</h3><span class="jn-mt">{{ product.price | money }}</span></div></a>{% endfor %}</div></div></main><script src="{{ 'kultra-nav.js' | asset_url }}" defer></script>