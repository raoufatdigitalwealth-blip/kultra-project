<main id="main" class="pg"><section class="pg-h"><svg class="lat" aria-hidden="true"><defs><pattern id="ca" width="90" height="78" patternUnits="userSpaceOnUse"><path d="M45 6l30 17v32L45 72 15 55V23z"/></pattern></defs><rect width="100%" height="100%" fill="url(#ca)"/></svg><div class="in"><div class="pg-eb">Cart</div><h1>Your <em>cart.</em></h1></div></section><div class="cr">{% if cart.item_count == 0 %}<div class="ck-in" style="text-align:center"><h2>Your cart is empty</h2><p><a class="pg-btn" href="/products/goat-whey-protein">Shop Goat Whey Protein</a></p></div>{% else %}<form action="/cart" method="post">{% for item in cart.items %}<div class="cr-i"><a href="{{ item.url }}">{% if item.image %}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}">{% endif %}</a><div><h3>{{ item.product.title }}</h3>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title }}</small>{% endunless %}{% if item.selling_plan_allocation %}<small>{{ item.selling_plan_allocation.selling_plan.name }}</small>{% endif %}<div class="cr-q"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}"><a href="{{ item.url_to_remove }}">Remove</a></div></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="cr-t"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div><p class="ck-nt">Taxes included. Discounts and shipping calculated at checkout.</p><div style="display:flex;gap:12px;flex-wrap:wrap"><button class="pg-btn" type="submit" name="update" style="background:#fff;color:#2F4A32;border:1px solid #2F4A32;box-shadow:none">Update cart</button><button class="pg-btn" type="submit" name="checkout">Check out</button></div></form>{% endif %}</div></main><script src="{{ 'kultra-nav.js' | asset_url }}" defer></script>