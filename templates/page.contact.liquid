<div class="ct-f-w">{% form 'contact', class: 'ct-f', id: 'ct-form', novalidate: 'novalidate' %}{% if form.posted_successfully? %}<div class="ct-ok" role="status"><b>Thank you.</b><p>Your message has been sent. We’ll be in touch soon.</p></div>{% else %}
<div class="ct-r"><label class="cf"><span>Name</span><input name="contact[name]" type="text" autocomplete="name"></label><label class="cf"><span>Email *</span><input name="contact[email]" type="email" autocomplete="email" required></label></div>
<label class="cf"><span>Phone number</span><input name="contact[phone]" type="tel" autocomplete="tel"></label><label class="cf"><span>Comment</span><textarea name="contact[body]"></textarea></label><p class="ct-er" id="ct-er" role="alert">{% if form.errors %}Please check the form and try again.{% endif %}</p><button class="pg-btn" type="submit">Send</button>
{% endif %}{% endform %}</div></div></div></main><script>{% raw %}(function(){var f=document.getElementById('ct-form');if(!f)return;var live=!!f.getAttribute('action');f.addEventListener('submit',function(e){var em=f.querySelector('[type=email]'),er=document.getElementById('ct-er');em.classList.remove('bad');if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em.value)){e.preventDefault();em.classList.add('bad');er.textContent='Please enter a valid email address.';em.focus();return}
if(!live){e.preventDefault();f.outerHTML='<div class="ct-ok" role="status"><b>Thank you.</b><p>Your message has been sent. We’ll be in touch soon.</p></div>'}})})();{% endraw %}</script><script src="{{ 'kultra-nav.js' | asset_url }}" defer></script>