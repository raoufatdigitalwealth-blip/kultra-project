<main id="main" class="pg"><section class="pg-h"><svg class="lat" aria-hidden="true"><defs><pattern id="kh" width="90" height="78" patternUnits="userSpaceOnUse"><path d="M45 6l30 17v32L45 72 15 55V23z"/></pattern></defs><rect width="100%" height="100%" fill="url(#kh)"/></svg><div class="in"><div class="pg-eb">Ingredient Checker</div><h1>Read any label <em>in seconds.</em></h1><p>Paste the ingredient list from your current protein and see what is in it, side by side with Kultra.</p></div></section><div class="pg-w"><div class="ck"><div class="ck-in"><label for="ck-t">Paste an ingredient list</label><textarea id="ck-t" placeholder="Whey protein concentrate, maltodextrin, cocoa powder, xanthan gum, …"></textarea><div class="ck-ex"><span>Try an example:</span><button type="button" data-e="0">Typical whey blend</button><button type="button" data-e="1">Plant blend</button></div><button class="pg-btn" id="ck-go" type="button">Check ingredients</button><p class="ck-nt">This is a simple keyword check to help you read a label. It is not medical or dietary advice, so always check the product’s own label for the full list.</p></div>
<div class="ck-out" aria-live="polite" id="ck-out"><h2>Your results will appear here.</h2><p>Paste a list and press Check. We’ll count the ingredients and highlight common additive types.</p></div></div></div></main><script>{% raw %}(function(){
var DB=[['Artificial sweetener',['sucralose','acesulfame','ace-k','ace k','aspartame','saccharin','neotame','advantame','e950','e951','e954','e955']],
['Gum or thickener',['xanthan','guar','cellulose gum','carboxymethylcellulose','carrageenan','gellan','gum arabic','acacia','locust bean','tara gum','konjac','e415','e412','e407','e466','e418']],
['Filler or bulking agent',['maltodextrin','dextrose','corn starch','cornstarch','rice starch','tapioca','potato starch','modified starch','cellulose','silicon dioxide','silica','magnesium stearate','dicalcium phosphate','tricalcium phosphate','calcium silicate','e551','e470']],
['Emulsifier',['lecithin','polysorbate','mono- and diglycerides','monoglyceride','e322','e471']],
['Flavouring or colour',['flavour','flavor','colour','color','caramel','e150','e102','e110','e129','e133','e171','titanium dioxide']],
['Protein source',['whey','casein','pea protein','rice protein','soy protein','soya','egg','collagen','hemp protein','protein isolate','protein concentrate','goat']],
['Sweetener',['stevia','steviol','monk fruit','erythritol','xylitol','sorbitol','sugar','sucrose','honey','maltitol','allulose','glycoside']]],
FLAG=['Artificial sweetener','Gum or thickener','Filler or bulking agent','Emulsifier','Flavouring or colour'],
EX=['Whey protein concentrate, maltodextrin, cocoa powder, xanthan gum, soy lecithin, natural and artificial flavours, sucralose, acesulfame potassium, silicon dioxide','Pea protein, rice protein, natural flavours, guar gum, xanthan gum, stevia extract, sunflower lecithin, salt, sucralose'],
t=document.getElementById('ck-t'),out=document.getElementById('ck-out'),reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
function cat(s){for(var i=0;i<DB.length;i++)for(var j=0;j<DB[i][1].length;j++)if(s.indexOf(DB[i][1][j])>-1)return DB[i][0];return ''}
function esc(s){return s.replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function run(){var raw=t.value.replace(/^\s*ingredients\s*:/i,'').replace(/\([^)]*\)/g,'');var items=raw.split(/[,;\n•|]+/).map(function(x){return x.replace(/\.$/,'').trim()}).filter(Boolean);
if(!items.length){out.innerHTML='<h2>Nothing to check yet.</h2><p>Paste an ingredient list and press Check.</p>';return}
var fl=0,cnt={};var chips=items.map(function(x,i){var c=cat(x.toLowerCase()),f=FLAG.indexOf(c)>-1;if(f){fl++;cnt[c]=(cnt[c]||0)+1}return '<li class="'+(f?'fl':'')+'" style="--i:'+i+'">'+(f?'<small>'+c+'</small>':'')+esc(x)+'</li>'}).join('');
var cats=Object.keys(cnt).map(function(k){return cnt[k]+' × '+k.toLowerCase()}).join(', '),mx=Math.max(items.length,3);
out.innerHTML='<h2>'+items.length+' ingredient'+(items.length>1?'s':'')+', '+fl+' highlighted</h2><p>Your list, side by side with Kultra.</p><div class="ck-vs"><div class="ck-bar"><span>Your list</span><i class="y"><b style="width:0" data-w="'+items.length/mx*100+'"></b></i><span>'+items.length+'</span></div><div class="ck-bar"><span>Kultra</span><i class="k"><b style="width:0" data-w="'+3/mx*100+'"></b></i><span>3</span></div></div><ul class="ck-ch">'+chips+'</ul>'+
'<p class="ck-sm">'+(fl?'Highlighted: '+cats+'. These are additive types commonly found in protein powders.':'No common additive types were highlighted in this list.')+'</p><div class="ck-kt"><b>Kultra:</b> goat whey concentrate, natural vanilla, stevia leaf. No gums, no fillers, no artificial sweeteners.</div><a class="pg-btn" href="https://kultra.co.uk/products/goat-whey-protein">Shop Goat Whey Protein</a>';
setTimeout(function(){[].forEach.call(out.querySelectorAll('[data-w]'),function(b){b.style.width=b.dataset.w+'%'})},reduce?0:60)}
document.getElementById('ck-go').addEventListener('click',run);
[].forEach.call(document.querySelectorAll('.ck-ex button'),function(b){b.addEventListener('click',function(){t.value=EX[+b.dataset.e];run()})});})();{% endraw %}</script><script src="{{ 'kultra-nav.js' | asset_url }}" defer></script>