<main id="main" class="pg"><section class="pg-h"><svg class="lat" aria-hidden="true"><defs><pattern id="jh" width="90" height="78" patternUnits="userSpaceOnUse"><path d="M45 6l30 17v32L45 72 15 55V23z"/></pattern></defs><rect width="100%" height="100%" fill="url(#jh)"/></svg><div class="in"><div class="pg-eb">The Kultra Journal</div><h1>Stories, recipes <em>and ideas.</em></h1><p>Recipes, label-reading and the story behind Kultra.</p></div></section><div class="pg-w">{% paginate blog.articles by 12 %}{% assign first = blog.articles.first %}
{% if first and paginate.current_page == 1 %}<a class="jn-ft" href="{{ first.url }}">{% if first.image %}<img src="{{ first.image | image_url: width: 1000 }}" alt="{{ first.image.alt | escape }}">{% endif %}<div><span class="jn-tg">Featured{% if first.tags.first %} · {{ first.tags.first }}{% endif %}</span><h2>{{ first.title }}</h2><p>{{ first.excerpt_or_content | strip_html | truncate: 170 }}</p><span class="jn-rd">Read the story</span></div></a>{% endif %}
{% if blog.all_tags.size > 0 %}<div class="jn-fl" role="group" aria-label="Filter articles"><button type="button" data-f="all" aria-pressed="true">All</button>{% for tag in blog.all_tags %}<button type="button" data-f="{{ tag | handleize }}" aria-pressed="false">{{ tag }}</button>{% endfor %}</div>{% endif %}
<div class="jn-g">{% for article in blog.articles %}{% if forloop.first and paginate.current_page == 1 %}{% continue %}{% endif %}<a class="jn-c" href="{{ article.url }}" data-tags="{% for tag in article.tags %}{{ tag | handleize }}{% unless forloop.last %},{% endunless %}{% endfor %}"><div class="im">{% if article.image %}<img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | escape }}" loading="lazy">{% endif %}</div><div class="tx"><span class="jn-tg">{{ article.tags.first }}</span><h3>{{ article.title }}</h3><p>{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p><span class="jn-mt">{{ article.published_at | date: '%-d %B %Y' }}</span></div></a>{% endfor %}</div>
{% if paginate.pages > 1 %}<div class="jn-pg">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}<div class="jn-nl"><h2>Ready to switch to the goat way?</h2><p>New product releases and the latest offers, straight to your inbox.</p><a class="pg-btn" href="/products/goat-whey-protein">Shop Goat Whey Protein</a></div></div></main><script>{% raw %}(function(){var bs=[].slice.call(document.querySelectorAll('.jn-fl button')),cs=[].slice.call(document.querySelectorAll('.jn-c'));bs.forEach(function(b){b.addEventListener('click',function(){var f=b.dataset.f;bs.forEach(function(x){x.setAttribute('aria-pressed',x===b)});cs.forEach(function(c){c.hidden=!(f==='all'||(c.dataset.tags||'').split(',').indexOf(f)>-1)})})})})();{% endraw %}</script><script src="{{ 'kultra-nav.js' | asset_url }}" defer></script>